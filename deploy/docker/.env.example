# 宏禹水利管理平台 Docker 部署配置
# ./deploy.sh init 会复制本文件为 .env，并自动生成 DB_PASSWORD、JWT_SECRET

# Compose 项目名（容器名前缀）
COMPOSE_PROJECT_NAME=water-management
# 镜像版本标签（升级时可改为日期或版本号，便于回滚）
APP_VERSION=latest

# 访问端口：浏览器访问 http://服务器IP:HTTP_PORT
HTTP_PORT=80

# 数据目录：数据库文件与上传资料（建议放到数据盘，并纳入备份）
DATA_DIR=./data
# 备份目录与保留天数
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=30

# 数据库（容器内 PostgreSQL，不对外暴露端口）
DB_NAME=water_management
DB_USER=water
DB_PASSWORD=

# 登录令牌签名密钥（至少 32 个字符；修改后所有用户需重新登录）
JWT_SECRET=
JWT_EXPIRE=12h

# 单个文件上传上限（同时需与 nginx.conf 中 client_max_body_size 一致）
UPLOAD_MAX_SIZE=500MB

# 内部网盘：none 未对接；mount 以挂载目录方式访问
# 使用 mount 时先在宿主机挂载网盘，例如：
#   mount -t cifs //192.168.1.10/资料 /mnt/nas -o ro,username=xxx,password=xxx,iocharset=utf8
# 然后填写 NAS_HOST_DIR=/mnt/nas
NAS_TYPE=none
NAS_HOST_DIR=
NAS_MAX_FILES=20000

# 后端 JVM 参数（默认按容器内存的 75% 设置堆上限）
JAVA_OPTS=-XX:MaxRAMPercentage=75 -Dfile.encoding=UTF-8 -Duser.timezone=Asia/Shanghai

# 构建镜像时的软件源（服务器访问外网慢时填写，留空使用官方源）
# MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR=
NPM_REGISTRY=
